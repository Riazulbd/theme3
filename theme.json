		"typography": {
			"fontFamily": "var(--wp--preset--font-family--solaimanlipi)",
			"fontWeight": "400"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "400"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent-purple)",
					"text": "var(--wp--preset--color--paper)"
				},
				"typography": {
					"fontWeight": "400"
				},
				"border": {
					"radius": "4px"
				}
			}
		}
	}
