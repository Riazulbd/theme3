				},
				{
					"slug": "16",
					"name": "16",
					"size": "16px"
				},
				{
					"slug": "24",
					"name": "24",
					"size": "24px"
				},
				{
					"slug": "32",
					"name": "32",
					"size": "32px"
				},
				{
					"slug": "48",
					"name": "48",
					"size": "48px"
				},
				{
					"slug": "64",
					"name": "64",
					"size": "64px"
				},
				{
					"slug": "96",
