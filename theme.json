			"letterSpacing": false,
			"lineHeight": false,
			"textDecoration": false,
			"textTransform": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "solaimanlipi",
					"name": "SolaimanLipi (Bengali) + Inter (Latin)",
					"fontFamily": "\"NN Inter\", \"SolaimanLipi\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "small / caption · 14",
					"size": "14px"
				},
				{
					"slug": "summary",
					"name": "body-summary · 16",
					"size": "16px"
