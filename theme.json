					"slug": "body",
					"name": "body-article · 20",
					"size": "20px"
				},
				{
					"slug": "deck",
					"name": "deck · 22",
					"size": "22px"
				},
				{
					"slug": "h2",
					"name": "h2 · 24",
					"size": "24px"
				},
				{
					"slug": "headline-l",
					"name": "headline-L · 28",
					"size": "28px"
