			"duotone": [],
			"gradients": [],
			"link": false,
			"palette": [
				{
					"slug": "ink-900",
					"name": "ink/900 · headlines, body",
					"color": "#0B0B12"
				},
				{
					"slug": "ink-700",
					"name": "ink/700 · summaries",
					"color": "#3A3A48"
				},
				{
					"slug": "ink-500",
					"name": "ink/500 · captions, icons",
					"color": "#6B6B7B"
				},
				{
					"slug": "line-200",
					"name": "line/200 · dividers",
					"color": "#E6E6EE"
				},
				{
					"slug": "surface-50",
					"name": "surface/50 · drawer, footer",
					"color": "#F7F7FA"
				},
				{
					"slug": "paper",
					"name": "paper · page",
					"color": "#FFFFFF"
				},
				{
					"slug": "accent-purple",
					"name": "accent/purple · focus, active",
					"color": "#6D28D9"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
